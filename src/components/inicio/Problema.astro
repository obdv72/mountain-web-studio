---
/*
  Problema: título gigante en las columnas 1 a 7 y, a la derecha, 3 puntos numerados
  con una línea encima. En celular, apilado.
*/
import Contenedor from "../ui/Contenedor.astro";

const puntos = [
  {
    titulo: "Clientes de fuera que no te encuentran",
    texto: "Si no apareces bien en Google, las consultas internacionales se van a otro.",
  },
  {
    titulo: "Fondos que piden un portafolio serio",
    texto: "Becas y convocatorias revisan tu presencia en línea antes de leer tu propuesta.",
  },
  {
    titulo: "Proyectos perdidos entre redes",
    texto: "Instagram muestra lo último, no lo mejor. Tu mejor trabajo queda enterrado.",
  },
];
---

<section id="problema" class="py-24 md:py-36">
  <Contenedor class="grid gap-12 lg:grid-cols-12 lg:gap-x-6">
    <h2 class="text-[13vw] leading-[0.9] md:text-8xl lg:col-span-7" data-revelar>
      Tu trabajo es bueno. Tu web no lo dice.
    </h2>
    <ol class="flex flex-col gap-8 lg:col-span-5 lg:pt-3" data-revelar-cascada>
      {
        puntos.map((punto, i) => (
          <li class="grid grid-cols-[3rem_1fr] border-t border-borde pt-5">
            <span class="rotulo">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-lg font-medium">{punto.titulo}</h3>
              <p class="mt-2 text-texto-suave">{punto.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Contenedor>
</section>
