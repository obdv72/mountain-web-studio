---
/*
  Clientes: rótulo y nombres separados por "·".
  Celular: rótulo arriba, nombres debajo. Computadora: rótulo a la izquierda, nombres en línea.
*/
import Contenedor from "../ui/Contenedor.astro";

const clientes = [
  "Sesiones Al Parque",
  "Tania Cortés Becerra",
  "Mountain Studio Lab",
  "Ana Cristina Torres",
];
---

<section id="clientes" class="border-y border-borde py-8">
  <Contenedor class="flex flex-col gap-3 lg:flex-row lg:items-baseline lg:gap-10">
    <p class="shrink-0 rotulo">Han confiado en nosotros</p>
    <ul class="flex flex-wrap gap-x-2 gap-y-1 text-lg" data-revelar>
      {
        clientes.map((cliente, i) => (
          <li>
            {cliente}
            {i < clientes.length - 1 && (
              <span class="ml-2 hidden text-texto-suave lg:inline" aria-hidden="true">
                ·
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </Contenedor>
</section>
