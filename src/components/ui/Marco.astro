---
/*
  Marco de imagen: marcas de encuadre en las cuatro esquinas (líneas de 1px en color texto)
  y un rótulo pequeño arriba a la izquierda (sección 5 del brief).

  Uso:
    <Marco src={foto} alt="Texto del brief" rotulo="CASO 01 · ARCHIVO" />
*/
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  rotulo: string;
  class?: string;
  sizes?: string;
}

const { src, alt, rotulo, class: clase, sizes = "(min-width: 1024px) 66vw, 100vw" } = Astro.props;

const esquina = "pointer-events-none absolute size-5 border-texto";
---

<figure class:list={["relative bg-superficie p-3 sm:p-4", clase]}>
  <Image src={src} alt={alt} sizes={sizes} class="block h-auto w-full" />
  <span aria-hidden="true" class:list={[esquina, "top-0 left-0 border-t border-l"]}></span>
  <span aria-hidden="true" class:list={[esquina, "top-0 right-0 border-t border-r"]}></span>
  <span aria-hidden="true" class:list={[esquina, "bottom-0 left-0 border-b border-l"]}></span>
  <span aria-hidden="true" class:list={[esquina, "right-0 bottom-0 border-r border-b"]}></span>
  <figcaption class="absolute top-5 left-5 bg-fondo px-2 py-1 rotulo sm:top-6 sm:left-6">
    {rotulo}
  </figcaption>
</figure>
