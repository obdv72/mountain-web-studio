---
/*
  Pie de página (sección 10 del brief; referencia 1b).
  Computadora: línea de 1px · tres columnas (Menú · Redes · Contacto) con su rótulo sobre una línea ·
  correo gigante · última línea con los datos del estudio y el botón HUD a la derecha.
  Celular: columnas apiladas y correo en dos líneas.
*/
import Contenedor from "./ui/Contenedor.astro";
import { enlaceWhatsApp, menu, redes, sitio } from "../datos/sitio";

const [usuario, dominio] = sitio.correo.split("@");

const columnas = [
  { rotulo: "Menú", enlaces: menu.map((m) => ({ texto: m.texto, href: m.href, externo: false })) },
  {
    rotulo: "Redes",
    enlaces: redes.map((r) => ({ texto: r.nombre, href: r.href, externo: true })),
  },
  {
    rotulo: "Contacto",
    enlaces: [
      { texto: "WhatsApp", href: enlaceWhatsApp(), externo: true },
      { texto: "Correo", href: `mailto:${sitio.correo}`, externo: false },
    ],
  },
];
---

<footer class="border-t border-borde pt-16 pb-24 md:pb-10">
  <Contenedor>
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-6">
      {
        columnas.map((columna, i) => (
          <div class:list={[i === 0 ? "md:col-span-6" : "md:col-span-3"]}>
            <p class="border-b border-borde pb-3 rotulo">{columna.rotulo}</p>
            <ul class="mt-4 space-y-1.5">
              {columna.enlaces.map((e) => (
                <li>
                  <a
                    href={e.href}
                    class="underline-offset-4 hover:underline"
                    target={e.externo ? "_blank" : undefined}
                    rel={e.externo ? "noopener" : undefined}
                  >
                    {e.texto}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <a
      href={`mailto:${sitio.correo}`}
      class="mt-16 block font-titulos text-[9.5vw] leading-[0.95] uppercase transition-colors duration-200 hover:text-texto-suave motion-reduce:transition-none md:mt-24 md:text-[7.5vw] lg:text-[6rem]"
    >
      {usuario}@<br class="sm:hidden" />{dominio}
    </a>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-borde pt-6 text-sm text-texto-suave sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{sitio.pie}</p>
      <button
        type="button"
        data-hud-boton
        aria-pressed="false"
        class="self-start border border-borde px-3 py-1.5 rotulo text-texto hover:border-marca sm:self-auto"
      >
        HUD: OFF
      </button>
    </div>
  </Contenedor>
</footer>
