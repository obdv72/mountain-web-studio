---
/*
  Planes (precios en USD): 3 tarjetas sobre superficie con borde de 1px.
  La del medio va destacada: borde en color marca y rótulo "Recomendado".
  Cada botón abre WhatsApp con el plan ya escrito. En celular, apiladas en orden.
*/
import Boton from "../ui/Boton.astro";
import Contenedor from "../ui/Contenedor.astro";
import { enlaceWhatsApp } from "../../datos/sitio";

const planes = [
  {
    nombre: "Esencial",
    precio: "$450",
    destacado: false,
    incluye: [
      "Sitio de una página",
      "Presentación, trabajo y contacto",
      "Adaptado a celular",
      "Entrega en 2 semanas",
    ],
    mensaje: "Hola, me interesa el plan Esencial.",
  },
  {
    nombre: "Profesional",
    precio: "$950",
    destacado: true,
    incluye: [
      "Hasta 5 páginas",
      "Portafolio con fichas de proyecto",
      "Español e inglés",
      "Posicionamiento básico en Google",
      "Entrega en 4 semanas",
    ],
    mensaje: "Hola, me interesa el plan Profesional.",
  },
  {
    nombre: "Integral",
    precio: "$1.800",
    destacado: false,
    incluye: [
      "Todo lo del plan Profesional",
      "Páginas ilimitadas y casos de estudio",
      "Textos y estructura de contenido",
      "Capacitación y 3 meses de soporte",
      "Entrega en 6 semanas",
    ],
    mensaje: "Hola, me interesa el plan Integral.",
  },
];
---

<section id="planes" class="border-t border-borde py-24 md:py-32">
  <Contenedor>
    <p class="rotulo">Planes · Precios en USD</p>

    <ul class="mt-8 grid gap-6 lg:grid-cols-3" data-revelar-cascada>
      {
        planes.map((plan) => (
          <li
            class:list={[
              "flex flex-col border bg-superficie p-6 md:p-8",
              plan.destacado ? "border-marca" : "border-borde",
            ]}
          >
            <p class="min-h-5 rotulo">{plan.destacado ? "Recomendado" : ""}</p>
            <h3 class="mt-3 font-titulos text-5xl uppercase">{plan.nombre}</h3>
            <p class="mt-2 text-3xl font-medium">{plan.precio}</p>
            <ul class="mt-8 mb-10 border-b border-borde text-sm">
              {plan.incluye.map((item) => (
                <li class="border-t border-borde py-3 text-texto-suave">{item}</li>
              ))}
            </ul>
            <Boton
              href={enlaceWhatsApp(plan.mensaje)}
              externo
              variante={plan.destacado ? "primario" : "secundario"}
              class="mt-auto w-full"
            >
              Elegir {plan.nombre}
            </Boton>
          </li>
        ))
      }
    </ul>
  </Contenedor>
</section>
