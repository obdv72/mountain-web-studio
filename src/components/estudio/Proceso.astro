---
/*
  Proceso, "La ruta" (interacción 4): al bajar, una línea vertical en color marca se dibuja
  hacia abajo y enciende cada estación al llegar a ella (src/scripts/interacciones.ts).
  Computadora: la línea va en la columna 3 y las estaciones a su derecha.
  Celular: la línea pegada al borde izquierdo.
  Sin JavaScript o con "reducir movimiento", la línea se ve completa y todas las estaciones encendidas.
*/
import Contenedor from "../ui/Contenedor.astro";

const estaciones = [
  {
    nombre: "Campo base",
    altitud: "2.850 m",
    etapa: "Diagnóstico",
    texto:
      "conversamos sobre tu trabajo, tu público y tus metas, y definimos qué debe lograr el sitio.",
  },
  {
    nombre: "Campo 1",
    altitud: "3.800 m",
    etapa: "Contenido",
    texto: "ordenamos textos, imágenes y proyectos; decidimos qué se muestra y en qué orden.",
  },
  {
    nombre: "Campo 2",
    altitud: "4.800 m",
    etapa: "Diseño y desarrollo",
    texto: "diseñamos y construimos el sitio, y lo revisas en cada avance.",
  },
  {
    nombre: "Cumbre",
    altitud: "6.263 m",
    etapa: "Lanzamiento",
    texto: "publicamos, te enseñamos a actualizarlo y el sitio queda a tu nombre.",
  },
];
---

<section id="proceso" class="border-t border-borde py-24 md:py-36">
  <Contenedor class="grid gap-12 lg:grid-cols-12 lg:gap-x-6">
    <div class="lg:col-span-12">
      <h2 class="text-[12vw] leading-[0.9] md:text-7xl lg:text-8xl" data-revelar>La ruta</h2>
      <p class="mt-4 text-lg text-texto-suave" data-revelar>
        Cuatro etapas, del diagnóstico al lanzamiento.
      </p>
    </div>

    <ol class="relative lg:col-span-9 lg:col-start-3" data-ruta>
      <span aria-hidden="true" class="absolute top-0 bottom-0 left-[5px] w-px bg-borde"></span>
      <span
        aria-hidden="true"
        data-ruta-linea
        class="absolute top-0 bottom-0 left-[5px] w-px origin-top bg-marca"></span>
      {
        estaciones.map((e) => (
          <li data-estacion class="group relative pb-14 pl-10 last:pb-0 md:pl-14">
            <span
              aria-hidden="true"
              class="absolute top-1.5 left-0 size-[11px] border border-marca bg-fondo transition-colors duration-300 group-data-[encendida]:bg-marca motion-reduce:transition-none"
            />
            <p class="rotulo">{e.altitud}</p>
            <h3 class="mt-2 text-2xl font-medium md:text-3xl">{e.nombre}</h3>
            <p class="mt-3 max-w-xl text-texto-suave">
              <span class="text-texto">{e.etapa}:</span> {e.texto}
            </p>
          </li>
        ))
      }
    </ol>
  </Contenedor>
</section>
